# The sidecar's settings on one host. The easy way to write this file is
#   IMAGE=<image tag> scripts/preflight.sh --env > .env
# which reads the old container's mounts. By hand: copy this file to .env next to compose.yaml and replace the
# example values. The mounts of the old container are shown by
#   docker inspect -f '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{println}}{{end}}' <old container>
IMAGE=ghcr.io/huangsen365/php85-sidecar:8.5.12-20261115
BIND_IP=172.17.0.1

V=/path/to/nas/centos7-remi-php-master/yourdomain.com/volumes/volume_yourdomain.com
# Shared by both servers (NAS), same sources the old container mounts:
WWW_DIR=${V}/var/www
PHP74_LIB_DIR=${V}/var/opt/remi/php74/lib/php
# New, next to php74's php-fpm2.d; one pool file per site moved to 8.5:
POOL_DIR=${V}/etc/opt/remi/php85/php-fpm2.d
# Per server, local disk; must be writable by uid 1000:
LOG_DIR=/var/log/php85-sidecar

# Read by scripts/*.sh, not by compose: the old container's name, and where its php74 pools and vhosts are on the host.
OLD_CONTAINER=
PHP74_POOL_DIR=${V}/etc/opt/remi/php74/php-fpm2.d
VHOST_DIR=${V}/etc/httpd/conf2.d
